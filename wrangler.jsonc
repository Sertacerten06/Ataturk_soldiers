{
  // ArpaSphere: site/ statik dosyaları + worker/ (arşivlere CORS'lu ara katman). Yayın: npx wrangler deploy
  "name": "arpasphere",
  "main": "worker/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "site", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "workers_dev": true,
  "routes": [ { "pattern": "sphere.arpama.tr", "custom_domain": true } ]
}
